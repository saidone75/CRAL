{:paths ["src" "resources"]
 :deps {org.clojure/clojure {:mvn/version "1.12.4"}
        org.clojure/data.json {:mvn/version "2.5.2"}
        org.clj-commons/clj-http-lite {:mvn/version "1.0.13"}
        com.taoensso/telemere {:mvn/version "1.2.1"}}
 :aliases
 {:dev {:extra-paths ["test" "test-resources"]}
  :repl {:extra-paths ["test" "test-resources"]
         :main-opts ["-e" "(require 'cral.core) (in-ns 'cral.core)" "-r"]}
  :test {:extra-paths ["test" "test-resources"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
         :main-opts ["-m" "cognitect.test-runner"]
         :exec-fn cognitect.test-runner.api/test}
  :build {:deps {io.github.clojure/tools.build {:mvn/version "0.10.12"}
                 slipset/deps-deploy {:mvn/version "0.2.5"}}
          :ns-default build}}}
